GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_MODEL=gemini-2.5-pro
VERTEX_FAST_MODEL=gemini-3.1-flash-lite
VERTEX_GROUNDING_MODEL=gemini-2.5-flash
LIVE_STT_PROVIDER=speechmatics
HF_TOKEN=
SPEECHMATICS_API_KEY=
SPEECHMATICS_REALTIME_URL=wss://us.rt.speechmatics.com/v2
SPEECHMATICS_LANGUAGE=en
SPEECHMATICS_OPERATING_POINT=enhanced
SPEECHMATICS_SAMPLE_RATE=16000
# Diarization tuning. Defaults below are tuned for real debates (fast back-and-forth
# between distinct speakers), where separating speakers matters most:
#   SPEAKER_SENSITIVITY (0-1)    -> higher = more distinct speakers; lower merges similar voices into one.
#                                   ~0.5-0.6 for debates. Drop only if you get phantom speakers from a noisy room.
#   PREFER_CURRENT_SPEAKER       -> true sticks with the current speaker (good vs noise, but in a fast debate it
#                                   over-sticks and merges the next person). false switches readily -> better for debates.
#   VOLUME_THRESHOLD (0-100)     -> Speechmatics SILENCES audio quieter than this BEFORE transcription. KEEP AT 0 unless
#                                   the mic input is loud/clean: even 3 can wipe out a quiet mic entirely (= no transcription).
#   MAX_SPEAKERS                 -> cap; set near the real number of debaters to stop noise inventing extras.
SPEECHMATICS_PREFER_CURRENT_SPEAKER=false
SPEECHMATICS_VOLUME_THRESHOLD=0
SPEECHMATICS_SPEAKER_SENSITIVITY=0.5
SPEECHMATICS_MAX_SPEAKERS=10
SPEECHMATICS_RECOVERY_BUFFER_MS=60000
SPEECHMATICS_RECONNECT_INITIAL_MS=500
SPEECHMATICS_RECONNECT_MAX_MS=15000
SPEECHMATICS_HEARTBEAT_MS=30000
FIRECRAWL_API_KEY=
FIRECRAWL_SEARCH_TIMEOUT_MS=12000
FIRECRAWL_SEARCH_LIMIT=4
FIRECRAWL_EXCLUDED_DOMAINS=facebook.com,x.com,twitter.com,reddit.com,tiktok.com,instagram.com,quora.com
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=8
PORT=8787
