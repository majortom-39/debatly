{
  "name": "debatly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c gray,white \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --env-file=.env server/index.mjs",
    "dev:api:watch": "node --watch-path=server --env-file=.env server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "start": "node --env-file=.env server/index.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "@supabase/supabase-js": "^2.105.4",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.561.0",
    "modern-screenshot": "^4.7.0",
    "ogl": "^1.0.11",
    "pg": "^8.20.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^2.15.4",
    "vite": "^8.0.0",
    "ws": "^8.18.3",
    "youtube-dl-exec": "^3.1.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
